{
  "name": "stathmas",
  "version": "0.1.0",
  "description": "An advent calendar of Jason Statham action vehicles.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13 <25" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js --preview",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/*.test.js\""
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
